[Unit]
Description=Specmontazh TO API (Fastify)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=smto
Group=smto
WorkingDirectory=/opt/sm-to
EnvironmentFile=/opt/sm-to/.env
ExecStart=/usr/bin/node apps/api/dist/server.js
Restart=on-failure
RestartSec=5

# Сервер общий: ограничиваем память и права процесса.
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
