[Unit]
Description=Specmontazh TO: ежедневный запуск планировщика в 00:10 МСК

[Timer]
# Часовой пояс указан явно: системное время сервера UTC, менять его нельзя
# (на сервере другие проекты).
OnCalendar=*-*-* 00:10:00 Europe/Moscow
# Если сервер был выключен в 00:10, запуск произойдёт после загрузки (BR-02).
Persistent=true

[Install]
WantedBy=timers.target
