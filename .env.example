# Копируется в .env. Сам .env в репозиторий не попадает.

NODE_ENV=production
TZ=Europe/Moscow

# API слушает только localhost, снаружи доступ через nginx.
HOST=127.0.0.1
PORT=3010

# На сервере: unix-сокет и peer-аутентификация, пароль не нужен.
# Локально: postgresql://sm_to:sm_to@localhost:5432/sm_to_dev
DATABASE_URL=postgresql:///sm_to?host=/var/run/postgresql

# Origin фронтенда: проверка заголовка Origin для CSRF.
APP_ORIGIN=https://specmontazh.online

# Генерация заданий (раздел 5 спецификации).
SCHEDULER_HORIZON_DAYS=5

# Первый администратор: нужен только для db:seed, после него удалить.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
